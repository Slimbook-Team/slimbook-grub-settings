#!/bin/sh

set -e

#DEBHELPER#

CFGFILE="deepsleep"

if ! ischroot; then

    if [ -f /usr/bin/kernelstub ]; then
        STUB=$(cat "/etc/default/grub.d/slimbook-$CFGFILE-fix.cfg" | sed -e 's/GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT /"/g' | tr -d \")

        kernelstub -d $STUB
    fi
fi

exit 0
